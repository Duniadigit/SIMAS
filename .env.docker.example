BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SIMAS_SEED_PASSWORD=admin_password_kuat
SIMAS_ADMIN_CAN_APPROVE=true
SIMAS_NUMBER_FORMAT="{seq}/UN58.HB/{code}/{year}"
